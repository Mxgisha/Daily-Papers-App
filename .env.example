# Copy to .env and adjust. The defaults match docker-compose.yml.

DATABASE_URL=postgresql://dailypapers:dailypapers@localhost:5433/dailypapers

# Sent as User-Agent to arXiv / OpenAlex. Put a real contact here before any real crawl.
CONTACT_EMAIL=spike@example.com

# arXiv categories to ingest for the daily feed.
ARXIV_CATEGORIES=cs.LG,cs.CL,cs.CV,cs.AI

# Minimum seconds between requests to the same host (arXiv asks for politeness).
HTTP_MIN_INTERVAL=0.6
