# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pip-cache/
.hf-cache/

# Regenerable local data: crawled papers, built bundles, benchmark scratch
data/
dist/
dist-*/
bench/

# ---- Secrets ----
.env
.env.local

# ---- Node / Expo ----
node_modules/
.expo/
expo-env.d.ts

# Native projects are generated by `expo prebuild` on every build
android/
ios/

# ---- Verification output ----
# The harness writes its own artifacts here. Screenshots worth keeping live in
# docs/screenshots/; reports/ is committed for the shots the docs reference.
dist-web/
mobile/.harness/
mobile/.tmp/
mobile/data/
mobile/tests/fixtures/
preview/

# Tool caches created when running installs inside a sandbox
.home/
.npm-cache/

# Measurement output, regenerated by the harnesses
reports/*.json
.bench/
