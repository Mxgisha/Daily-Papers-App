{
  "name": "daily-papers-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --import tsx --test tests/feed.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "gen:reader-css": "node scripts/gen-reader-css.mjs",
    "fixtures": "../.venv/bin/python tests/make_fixtures.py --bundle ../dist --out tests/fixtures",
    "serve:bundle": "cd ../dist && python3 -m http.server 8000"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "fast-xml-parser": "^5.11.2",
    "fzstd": "^0.1.1",
    "js-sha256": "^1.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
