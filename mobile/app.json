{
  "expo": {
    "name": "Daily Papers",
    "slug": "daily-papers",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dailypapers",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#16181c"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dailypapers"
    },
    "android": {
      "package": "app.dailypapers",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#16181c"
      }
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
